{
  "schemaVersion": 1,
  "id": "nikodem.chip402",
  "name": "chip402",
  "version": "1.0.0",
  "author": "Nikodem Dominiak",
  "license": "MIT",
  "description": "Pocket-money chips for local AI agents paying x402 invoices, with a bar kill switch.",
  "homepage": "https://github.com/Nikodem01/chip402",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "chip402",
    "description": "Balance, today's spend, live ledger, and a kill switch for agent payments.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 15
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
