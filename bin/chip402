#!/usr/bin/env node
import { spawn } from "node:child_process";
import fs from "node:fs/promises";
import path from "node:path";
import { fileURLToPath } from "node:url";
import crypto from "node:crypto";
import {
  CONFIG_DIR,
  DEFAULT_DAILY_MICRO,
  DEFAULT_PER_REQUEST_MICRO,
  DEFAULT_PORT,
  DEFAULT_SELLER_PORT,
  KEY_PATH,
  MERCHANT_KEY_PATH,
  RUNTIME_DIR,
  SOCKET_PATH,
  TOKEN_PATH,
} from "../daemon/lib/paths.mjs";
import { call, daemonTarget, daemonUp as socketUp, readToken } from "../daemon/lib/client.mjs";
import {
  keyExists,
  loadConfig,
  saveConfig,
  writeKeyFile,
} from "../daemon/lib/state.mjs";
import { generateOperator, hashscanAccount, lookupAccount } from "../daemon/lib/hedera.mjs";
import { TESTNET, mainnetBlockedMessage, resolveNetwork } from "../daemon/lib/networks.mjs";
import { runtimeHint } from "../daemon/lib/sdk.mjs";

const here = path.dirname(fileURLToPath(import.meta.url));
const root = path.resolve(here, "..");
const daemonPath = path.join(root, "daemon", "chip402d.mjs");
const sellerPath = path.join(root, "demo", "seller.mjs");
const tcp = process.env.CHIP402_TCP === "1";
const target = daemonTarget({ tcp, port: process.env.CHIP402_PORT || DEFAULT_PORT });
let token = "";

function usage() {
  console.log(`chip402 — spend-capped x402 payments for local agents

Usage:
  chip402 status
  chip402 setup [--watch]
  chip402 fetch <url>
  chip402 pause
  chip402 resume
  chip402 cap daily <usdc>
  chip402 cap request <usdc>
  chip402 allow <host>
  chip402 network [testnet|mainnet]
  chip402 token
  chip402 fund
  chip402 demo
  chip402 log [--kind payment|audit|denied] [--since 6h|7d] [--json]
  chip402 tail
`);
}

// The daemon speaks HTTP over a unix socket unless TCP is explicitly opted into, in which
// case a bearer token from ~/.config/chip402/token is required.
async function api(method, pathname, body) {
  if (tcp && !token) token = await readToken();
  return call(target, method, pathname, body, { token });
}

async function daemonUp() {
  if (tcp && !token) token = await readToken();
  return socketUp(target, { token });
}

async function ensureRuntime() {
  await fs.mkdir(RUNTIME_DIR, { recursive: true });
  const pkg = path.join(RUNTIME_DIR, "package.json");
  try {
    await fs.access(pkg);
  } catch {
    await fs.writeFile(
      pkg,
      `${JSON.stringify({ name: "chip402-runtime", private: true, type: "module", dependencies: { "@hashgraph/sdk": "^2.81.0" } }, null, 2)}\n`,
    );
  }
  try {
    await fs.access(path.join(RUNTIME_DIR, "node_modules", "@hashgraph", "sdk"));
  } catch {
    console.error(`Installing @hashgraph/sdk into ${RUNTIME_DIR} …`);
    await run("bash", ["-lc", "npm install @hashgraph/sdk"], { cwd: RUNTIME_DIR });
  }
}

function run(cmd, args, opts = {}) {
  return new Promise((resolve, reject) => {
    const child = spawn(cmd, args, { stdio: "inherit", ...opts });
    child.on("exit", (code) => {
      if (code === 0) resolve();
      else reject(new Error(`${cmd} exited ${code}`));
    });
    child.on("error", reject);
  });
}

async function ensureDaemon() {
  if (await daemonUp()) return;
  await ensureRuntime();
  const child = spawn(process.execPath, [daemonPath], {
    stdio: "ignore",
    detached: true,
    env: process.env,
  });
  child.unref();
  for (let i = 0; i < 20; i += 1) {
    await new Promise((r) => setTimeout(r, 150));
    if (await daemonUp()) return;
  }
  throw new Error(`chip402d did not start on ${tcp ? `127.0.0.1:${DEFAULT_PORT}` : SOCKET_PATH}`);
}

function usdToMicro(value) {
  const n = Number(value);
  if (!Number.isFinite(n) || n < 0) throw new Error(`invalid USDC amount: ${value}`);
  return String(BigInt(Math.round(n * 1_000_000)));
}

function logOptions(argv) {
  const args = argv || [];
  let kind = "";
  let since = "";
  let json = false;
  for (let i = 0; i < args.length; i += 1) {
    const arg = String(args[i]);
    if (arg === "--json") json = true;
    else if (arg === "--kind") kind = String(args[++i] || "");
    else if (arg.startsWith("--kind=")) kind = arg.slice(7);
    else if (arg === "--since") since = String(args[++i] || "");
    else if (arg.startsWith("--since=")) since = arg.slice(8);
    else throw new Error(`unknown option ${arg} — chip402 log [--kind payment|audit|denied] [--since 6h|7d] [--json]`);
  }
  if (kind && !["payment", "audit", "denied"].includes(kind)) {
    throw new Error(`--kind must be payment, audit or denied, not ${kind}`);
  }
  return { kind, since: sinceMs(since), json };
}

// Accepts 90m, 6h, 7d. Returns a cutoff in epoch ms, or 0 for "everything retained".
function sinceMs(text) {
  const value = String(text || "").trim();
  if (value === "") return 0;
  const match = /^(\d+)([mhd])$/.exec(value);
  if (!match) throw new Error(`--since wants a duration like 90m, 6h or 7d, not ${value}`);
  const scale = { m: 60_000, h: 3_600_000, d: 86_400_000 }[match[2]];
  return Date.now() - Number(match[1]) * scale;
}

function matchesKind(row, kind) {
  if (!kind) return true;
  if (kind === "audit") return row.kind === "audit";
  if (kind === "denied") return row.status === "denied";
  return row.kind !== "audit";
}

function newerThan(row, cutoff) {
  if (!cutoff) return true;
  const at = Date.parse(String(row.ts || ""));
  return Number.isFinite(at) && at >= cutoff;
}

function printLogRow(row) {
  const when = new Date(row.ts).toLocaleString();
  if (row.kind === "audit") {
    console.log(`${when}  audit    ${row.action}`);
    if (row.detail) console.log(`  ${row.detail}`);
    return;
  }
  const amount = `${microToUsd(row.amountMicro)} USDC`.padStart(14);
  const where = row.host || row.url || "";
  console.log(`${when}  ${String(row.status || "").padEnd(8)}${amount}  ${where}${row.firstSight ? "  *new payee*" : ""}`);
  // The panel abbreviates these to a short label and drops them past today. Here they are whole.
  if (row.reason) console.log(`  ${row.code ? `${row.code}: ` : ""}${row.reason}`);
  if (row.txId) console.log(`  ${row.txId}`);
  if (row.hashscan) console.log(`  ${row.hashscan}`);
}

function microToUsd(value) {
  const n = BigInt(String(value || "0"));
  const whole = n / 1000000n;
  const frac = (n % 1000000n).toString().padStart(6, "0").replace(/0+$/, "");
  if (!frac) return `${whole}.00`;
  if (frac.length === 1) return `${whole}.${frac}0`;
  return `${whole}.${frac}`;
}

// Said once, at the only moment it matters: when the key comes into existence. Printed, not
// prompted — the panel runs `chip402 setup` non-interactively, so a question would hang it.
function keyDisclosure(config) {
  const daily = microToUsd(config.dailyCapMicro || DEFAULT_DAILY_MICRO);
  const perRequest = microToUsd(config.perRequestMicro || DEFAULT_PER_REQUEST_MICRO);
  console.log(`
About to create the operator key
────────────────────────────────
  chip402 generates a Hedera ECDSA key and stores it at
  ${KEY_PATH}, mode 600, UNENCRYPTED.

  There is no passphrase, and nobody holds one. A daemon that signs
  invoices while you are not watching cannot stop to ask for one, so
  this key is protected by file permissions and by the spend caps —
  not by a secret you remember.

  What that means in practice:
    · Anything running as your user can read the file. So can root.
      chip402 does not defend against code you already ran.
    · What it can lose is bounded by the caps, not by the key:
      ${daily} USDC per day, ${perRequest} USDC per request by default.
    · Treat the balance like a coat pocket, not a bank account. Top it
      up from a real wallet; do not park savings here.
    · To revoke it: rm ${KEY_PATH}
      Funds stay on Hedera, and nothing can move them without the key.

  This build signs on testnet only and refuses mainnet.
`);
}

async function setup(watch) {
  await ensureRuntime();
  const config = await loadConfig();
  if (!keyExists(KEY_PATH)) {
    keyDisclosure(config);
    const operator = generateOperator();
    await writeKeyFile(KEY_PATH, operator.der);
    config.evmAddress = operator.evmAddress;
    console.log(`Operator key written to ${KEY_PATH} (mode 600)`);
  } else if (!config.evmAddress) {
    const { parsePrivateKey, evmAddressFor } = await import("../daemon/lib/hedera.mjs");
    const { readKeyFile } = await import("../daemon/lib/state.mjs");
    const key = parsePrivateKey(await readKeyFile(KEY_PATH));
    config.evmAddress = evmAddressFor(key);
  }
  if (!keyExists(MERCHANT_KEY_PATH)) {
    const merchant = generateOperator();
    await writeKeyFile(MERCHANT_KEY_PATH, merchant.der);
    config.merchantEvmAddress = merchant.evmAddress;
    console.log(`Merchant key written to ${MERCHANT_KEY_PATH} (mode 600)`);
  }
  await saveConfig(config);
  printFund(config);
  if (!watch) return;
  console.log("Waiting for faucet / HashPack top-up (Ctrl-C to stop)…");
  for (;;) {
    const next = await loadConfig();
    let changed = false;
    if (next.evmAddress && !next.accountId) {
      const found = await lookupAccount(next.evmAddress, next.network);
      if (found?.accountId) {
        next.accountId = found.accountId;
        changed = true;
        console.log(`Operator account ${found.accountId}`);
      }
    }
    if (next.merchantEvmAddress && !next.merchantAccountId) {
      const found = await lookupAccount(next.merchantEvmAddress, next.network);
      if (found?.accountId) {
        next.merchantAccountId = found.accountId;
        changed = true;
        console.log(`Merchant account ${found.accountId}`);
      }
    }
    if (changed) await saveConfig(next);
    if (next.accountId) {
      console.log("Account is on-chain. Associating USDC happens on daemon refresh.");
      console.log("Then send testnet USDC to the operator (Circle faucet or HashPack).");
      return;
    }
    await new Promise((r) => setTimeout(r, 4000));
  }
}

function printFund(config) {
  const profile = resolveNetwork(config.network || TESTNET.id);
  console.log(`
chip402 is a prepaid card for Omarchy agents on ${profile.id}.
Spend assets: USDC ${profile.usdc} and HBAR 0.0.0 (USDC invoices in this build).

  1. Create the account with a little HBAR (association fees):
     ${profile.faucetHbar}
     ${config.evmAddress || "(run chip402 setup)"}

  2. After the account exists, chip402 associates USDC automatically.

  3. Top up this operator from HashPack or the faucet — keep real funds in HashPack.

Merchant (demo seller):

     ${config.merchantEvmAddress || "(none)"}

Config: ${CONFIG_DIR}
`);
}

async function printStatus() {
  await ensureDaemon();
  const status = await api("POST", "/refresh");
  const line = status.paused ? "PAUSED" : status.configured ? "LIVE" : "NEEDS FUNDING";
  console.log(`chip402  ${line}`);
  console.log(`Network    ${status.network || TESTNET.id}`);
  console.log(`Transport  ${tcp ? `127.0.0.1:${DEFAULT_PORT} (TCP)` : SOCKET_PATH}`);
  console.log(`Account    ${status.accountId || "—"}  ${status.evmAddress || ""}`);
  console.log(
    `Balance    ${microToUsd(status.balanceMicro)} USDC${status.balanceFresh ? "" : "  (STALE — payments denied)"}`,
  );
  console.log(`Today      ${microToUsd(status.spentTodayMicro)} / ${microToUsd(status.dailyCapMicro)} USDC`);
  if (status.pendingMicro && status.pendingMicro !== "0") {
    console.log(`Pending    ${microToUsd(status.pendingMicro)} USDC in flight`);
  }
  console.log(`Per req    ${microToUsd(status.perRequestMicro)} USDC`);
  console.log(`Fee payer  ${status.feePayer || "— (discovery failed; payments denied)"}`);
  if (status.hollow) console.log("Account    hollow — no key on record yet, completing it");
  if (status.associated === false) console.log("USDC       not associated yet");
  console.log(`Hosts      ${(status.allowHosts || []).join(", ")}`);
  if (status.accountUrl) console.log(`HashScan   ${status.accountUrl}`);
  if (status.floatWarning) console.log(`Float      ${status.floatWarning}`);
  if (status.facilitatorError) console.log(`Facilitator ${status.facilitatorError}`);
  if (status.lastError) console.log(`Error      ${status.lastError}`);
}

const [cmd, ...rest] = process.argv.slice(2);

try {
  if (!cmd || cmd === "-h" || cmd === "--help") {
    usage();
    process.exit(0);
  }
  if (cmd === "status") {
    await printStatus();
  } else if (cmd === "setup") {
    await setup(rest.includes("--watch"));
  } else if (cmd === "fund") {
    const config = await loadConfig();
    printFund(config);
    if (config.accountId) console.log(`Existing account: ${hashscanAccount(config.accountId, config.network)}`);
  } else if (cmd === "fetch") {
    const url = rest[0];
    if (!url) throw new Error("usage: chip402 fetch <url>");
    await ensureDaemon();
    const result = await api("POST", "/fetch", { url });
    console.log(JSON.stringify(result, null, 2));
  } else if (cmd === "pause") {
    await ensureDaemon();
    await api("POST", "/pause", { paused: true });
    console.log("paused");
  } else if (cmd === "resume") {
    await ensureDaemon();
    await api("POST", "/pause", { paused: false });
    console.log("live");
  } else if (cmd === "cap" && rest[0] === "daily") {
    await ensureDaemon();
    await api("POST", "/caps", { dailyMicro: usdToMicro(rest[1]) });
    console.log(`daily cap ${rest[1]} USDC`);
  } else if (cmd === "cap" && rest[0] === "request") {
    await ensureDaemon();
    await api("POST", "/caps", { perRequestMicro: usdToMicro(rest[1]) });
    console.log(`per-request cap ${rest[1]} USDC`);
  } else if (cmd === "network") {
    if (!rest[0] || rest[0] === "show") {
      const config = await loadConfig();
      const profile = resolveNetwork(config.network);
      console.log(profile.id);
      console.log(`USDC       ${profile.usdc}`);
      console.log(`HBAR       0.0.0`);
      console.log(`feePayer   ${profile.feePayer}`);
      console.log(`mainnet    ${mainnetBlockedMessage()}`);
    } else {
      const profile = resolveNetwork(rest[0]);
      console.log(profile.id);
    }
  } else if (cmd === "token") {
    const value = crypto.randomBytes(32).toString("hex");
    await writeKeyFile(TOKEN_PATH, value);
    console.log(`Bearer token written to ${TOKEN_PATH} (mode 600).`);
    console.log('Enable TCP with: chip402 config tcp on   (or set "tcp": true in config.json)');
    console.log("The unix socket needs no token; TCP is only for agents that cannot use one.");
  } else if (cmd === "allow") {
    const host = rest[0];
    if (!host) throw new Error("usage: chip402 allow <host>");
    await ensureDaemon();
    await api("POST", "/allow-host", { host });
    console.log(`allowed ${host}`);
  } else if (cmd === "demo") {
    await ensureRuntime();
    await run(process.execPath, [sellerPath], { cwd: root });
  } else if (cmd === "config" && rest[0] === "tcp") {
    const on = rest[1] === "on" || rest[1] === "true";
    const config = await loadConfig();
    config.tcp = on;
    await saveConfig(config);
    console.log(`TCP transport ${on ? "enabled — restart chip402d" : "disabled — restart chip402d"}`);
  } else if (cmd === "log") {
    // The panel shows the receipt book — recent payments, blocked attempts as a count, cap
    // changes beside the sliders. This is the same ledger with nothing folded away.
    await ensureDaemon();
    const { kind, since, json } = logOptions(rest);
    const status = await api("GET", "/status");
    const rows = (status.ledger || []).filter((row) => matchesKind(row, kind) && newerThan(row, since));
    if (json) {
      console.log(JSON.stringify(rows, null, 2));
    } else if (rows.length === 0) {
      console.log("no matching entries");
    } else {
      for (const row of rows) printLogRow(row);
      console.log(`${rows.length} of ${(status.ledger || []).length} retained entries`);
    }
  } else if (cmd === "tail") {
    await ensureDaemon();
    for (;;) {
      const status = await api("GET", "/status");
      console.clear?.();
      console.log(`spent today ${microToUsd(status.spentTodayMicro)} USDC   paused=${status.paused}`);
      for (const row of (status.ledger || []).slice(0, 12)) {
        const label = row.kind === "audit" ? `audit    ${row.action}` : row.status.padEnd(8);
        const mark = row.firstSight ? " *new payee*" : "";
        console.log(`${row.ts}  ${label}  ${microToUsd(row.amountMicro)} USDC  ${row.host || row.url || row.detail || ""}${mark}`);
        if (row.hashscan) console.log(`           ${row.hashscan}`);
      }
      await new Promise((r) => setTimeout(r, 2000));
    }
  } else if (cmd === "daemon") {
    await ensureRuntime();
    await run(process.execPath, [daemonPath], { cwd: root });
  } else {
    usage();
    process.exit(1);
  }
} catch (err) {
  console.error(err.body ? JSON.stringify(err.body, null, 2) : err.message);
  if (String(err.message || "").includes("Hedera SDK is not installed")) {
    console.error(runtimeHint());
  }
  process.exit(1);
}
